<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version Condition="'$(Version)' == ''">0.1.0-dev</Version>
    <Authors>Ishaan Makam</Authors>
    <Product>soundsys</Product>
    <Copyright>Copyright (c) 2026 Ishaan Makam</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Windows-specific projects share this TFM (CsWinRT projections for AudioPlaybackConnection) -->
    <SoundsysWindowsTfm>net10.0-windows10.0.22621.0</SoundsysWindowsTfm>
  </PropertyGroup>
</Project>
