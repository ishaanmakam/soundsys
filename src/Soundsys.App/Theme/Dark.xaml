<!-- soundsys palette, dark. Tokens from docs/UI_DESIGN.md; derived tokens are marked. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="InkColor">#F1EFEA</Color>
    <Color x:Key="InkMutedColor">#A8A49C</Color>
    <Color x:Key="SignalColor">#F2A93B</Color>
    <Color x:Key="SignalSoftColor">#33F2A93B</Color>
    <Color x:Key="AlertColor">#FF8A80</Color>
    <Color x:Key="HairlineColor">#1FFFFFFF</Color>
    <!-- Derived: tracks (InkMuted at 35 %), strip fills, hover wash, text on Signal, Mica stand-in for screenshots. -->
    <Color x:Key="TrackColor">#59A8A49C</Color>
    <Color x:Key="AlertSoftColor">#26FF8A80</Color>
    <Color x:Key="NoticeSoftColor">#12FFFFFF</Color>
    <Color x:Key="HoverColor">#0FFFFFFF</Color>
    <Color x:Key="OnSignalColor">#1C1B1A</Color>
    <Color x:Key="BackdropColor">#202020</Color>
    <!-- Accent buttons: Signal itself, with dark ink text. -->
    <Color x:Key="AccentButtonColor">#F2A93B</Color>
    <Color x:Key="AccentButtonHoverColor">#F5B95E</Color>
    <Color x:Key="AccentButtonPressedColor">#D9952F</Color>
    <Color x:Key="OnAccentColor">#1C1B1A</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMutedColor}" />
    <SolidColorBrush x:Key="SignalBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="SignalSoftBrush" Color="{StaticResource SignalSoftColor}" />
    <SolidColorBrush x:Key="AlertBrush" Color="{StaticResource AlertColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="AlertSoftBrush" Color="{StaticResource AlertSoftColor}" />
    <SolidColorBrush x:Key="NoticeSoftBrush" Color="{StaticResource NoticeSoftColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="OnSignalBrush" Color="{StaticResource OnSignalColor}" />
    <SolidColorBrush x:Key="BackdropBrush" Color="{StaticResource BackdropColor}" />

    <!-- Fluent accent overrides: receiver amber instead of Windows blue. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6F2A93B" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCF2A93B" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource AccentButtonColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource AccentButtonHoverColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource AccentButtonPressedColor}" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{StaticResource AccentButtonColor}" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{StaticResource AccentButtonHoverColor}" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{StaticResource AccentButtonPressedColor}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource OnAccentColor}" />
</ResourceDictionary>
