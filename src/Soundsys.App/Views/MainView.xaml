<UserControl x:Class="Soundsys.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Soundsys.App.Views"
             xmlns:vm="clr-namespace:Soundsys.App.ViewModels"
             Width="400" Height="660"
             Background="Transparent"
             FontFamily="{StaticResource TextFont}"
             FontSize="14"
             Foreground="{DynamicResource InkBrush}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Headline + detail: answers "is it playing, from whom, on which speakers?" -->
        <StackPanel Margin="24,16,24,0" AutomationProperties.LiveSetting="Polite">
            <TextBlock x:Name="HeadlineText" Style="{StaticResource HeadlineText}" Text="{Binding Headline}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,4,0,0" Text="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetailIsAlert}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AlertBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Margin="0,4,0,0" Style="{StaticResource LinkButton}" Content="Choose speakers"
                    Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:AppTab.Speakers}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Error (Alert) and notice (InkMuted) strips. -->
        <StackPanel Grid.Row="1" Margin="16,12,16,0">
            <Border Style="{StaticResource ErrorStrip}" Visibility="{Binding ErrorText, Converter={StaticResource NotEmptyToVisibility}}"
                    AutomationProperties.LiveSetting="Assertive">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding ErrorText}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="8,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DismissErrorCommand}" AutomationProperties.Name="Dismiss message" ToolTip="Dismiss" />
                </Grid>
            </Border>
            <Border Style="{StaticResource NoticeStrip}" Margin="0,8,0,0" Visibility="{Binding WarningText, Converter={StaticResource NotEmptyToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding WarningText}" />
                    <Button Margin="0,4,0,0" Style="{StaticResource LinkButton}" Content="Open sound settings" Command="{Binding OpenSoundSettingsCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Pages: the middle region changes, the tab bar stays. -->
        <views:HomePage Grid.Row="2" Visibility="{Binding SelectedTab, Converter={StaticResource EnumToVisible}, ConverterParameter=Home}" />
        <views:SpeakersPage Grid.Row="2" DataContext="{Binding SpeakersPage}"
                            Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisible}, ConverterParameter=Speakers}" />
        <views:PhonesPage Grid.Row="2" DataContext="{Binding PhonesPage}"
                          Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisible}, ConverterParameter=Phones}" />
        <views:SyncPage Grid.Row="2" DataContext="{Binding SyncPage}"
                        Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisible}, ConverterParameter=Sync}" />
        <views:SettingsPage Grid.Row="2" DataContext="{Binding SettingsPage}"
                            Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisible}, ConverterParameter=Settings}" />

        <!-- Tab bar -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairlineBrush}">
            <Grid Margin="24,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <RadioButton Style="{StaticResource Tab}" GroupName="Tabs" Content="Home" Margin="0,0,20,0"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Home}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Tabs" Content="Speakers" Margin="0,0,20,0"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Speakers}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Tabs" Content="Phones" Margin="0,0,20,0"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Phones}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Tabs" Content="Sync"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Sync}" />
                </StackPanel>
                <RadioButton Grid.Column="1" Style="{StaticResource Tab}" GroupName="Tabs" Width="36"
                             AutomationProperties.Name="Settings" ToolTip="Settings"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                </RadioButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
