<UserControl x:Class="Soundsys.App.Views.PhonesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Soundsys.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24,20,24,16">
            <TextBlock Style="{StaticResource BodyText}" Text="{x:Static vm:PhonesViewModel.Explainer}" />
            <TextBlock Style="{StaticResource LabelText}" Margin="0,4,0,0"
                       Text="Whichever phone started playing most recently is the one you hear. Switch a phone off here to ignore it." />

            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Phones}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PhoneRowViewModel}">
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Margin="0,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StateDot}">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{DynamicResource InkMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource InkMutedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SignalBrush}" />
                                                <Setter Property="Stroke" Value="{DynamicResource SignalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource LabelText}" Text="{Binding StateText}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding Name, StringFormat=Use {0}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding HasPhones, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource MutedText}" Text="No phones are paired with this laptop yet. Pair your phone in Bluetooth settings, then come back here." />
                <Button Margin="0,8,0,0" Style="{StaticResource LinkButton}" Content="Open Bluetooth settings" Click="OpenBluetooth_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
