<UserControl x:Class="Soundsys.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Soundsys.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24,12,24,16">
            <CheckBox Style="{StaticResource Switch}" Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
            <CheckBox Style="{StaticResource Switch}" Content="Start automatically when both speakers are on" IsChecked="{Binding AutoStart}" />
            <CheckBox Style="{StaticResource Switch}" Content="Keep the laptop awake while playing" IsChecked="{Binding KeepAwake}" />

            <Border Style="{StaticResource Separator}" Margin="0,12,0,16" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Updates" />
            <CheckBox Margin="0,4,0,0" Style="{StaticResource Switch}" Content="Check for updates once a day" IsChecked="{Binding CheckAutomatically}" />
            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Check for updates" Padding="14,5" Command="{Binding CheckUpdatesCommand}"
                    IsEnabled="{Binding CanCheckUpdates}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="{Binding UpdateResultText}" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding UpdateResultText, Converter={StaticResource NotEmptyToVisibility}}" />
            <Button Margin="0,8,0,0" Style="{StaticResource LinkButton}" Content="Download the new version" Command="{Binding OpenUpdateCommand}"
                    Visibility="{Binding UpdateUrl, Converter={StaticResource NotEmptyToVisibility}}" />

            <Button Margin="0,20,0,0" Style="{StaticResource QuietButton}" Content="{Binding VersionText}" Command="{Binding VersionClickedCommand}"
                    AutomationProperties.Name="{Binding VersionText}" />

            <!-- Developer (5 clicks on the version) -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding DeveloperUnlocked, Converter={StaticResource BoolToVisibility}}"
                        DataContext="{Binding Developer}">
                <Border Style="{StaticResource Separator}" Margin="0,0,0,16" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="Developer" />
                <CheckBox Margin="0,4,0,0" Style="{StaticResource Switch}" IsChecked="{Binding UseSimulated}" AutomationProperties.Name="Use simulated devices">
                    <StackPanel>
                        <TextBlock Text="Use simulated devices" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Pretend speakers and phones, entirely in memory. Silent." />
                    </StackPanel>
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{DynamicResource AccentButtonStyle}" Content="Restart soundsys" Padding="14,5" Command="{Binding RestartCommand}" />
                    <TextBlock Style="{StaticResource LabelText}" Margin="12,0,0,0" VerticalAlignment="Center" Text="Takes effect after a restart." />
                </StackPanel>

                <StackPanel Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,0" Text="Simulated speakers" />
                    <ItemsControl ItemsSource="{Binding SimSpeakers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SimSpeakerViewModel}">
                                <CheckBox Style="{StaticResource Switch}" Content="{Binding Name}" IsChecked="{Binding IsOn}"
                                          AutomationProperties.Name="{Binding Name, StringFormat={}{0} is on}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,4" Text="Simulated phones" />
                    <ItemsControl ItemsSource="{Binding SimPhones}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SimPhoneViewModel}">
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="{Binding StateText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Play" Padding="10,3" Command="{Binding PlayCommand}" AutomationProperties.Name="{Binding Name, StringFormat=Play on {0}}" />
                                        <Button Content="Pause" Padding="10,3" Margin="6,0,0,0" Command="{Binding PauseCommand}" AutomationProperties.Name="{Binding Name, StringFormat=Pause on {0}}" />
                                        <Button Content="Leave" Padding="10,3" Margin="6,0,0,0" Command="{Binding LeaveCommand}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} leaves}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Margin="0,8,0,0" Style="{StaticResource Switch}" Content="Laptop is playing" IsChecked="{Binding LaptopPlaying}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Show a sample error" Padding="12,5" Command="{Binding ShowSampleErrorCommand}" />
                        <Button Content="Forget speakers" Padding="12,5" Margin="8,0,0,0" Command="{Binding ForgetSpeakersCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
